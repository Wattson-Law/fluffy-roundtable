# ===== 知乎开放平台（服务端专用，严禁提交真实值） =====
ZHIHU_ACCESS_SECRET=

# ===== LLM（看山工作台 / 任意 OpenAI 兼容端点） =====
# 留空时 /api/roundtable/analyze 自动降级为规则引擎，Demo 不白屏
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 可选：主模型返回 402（余额不足）/429（限流）时按序自动降级，逗号分隔
LLM_MODEL_FALLBACKS=

# ===== [P1] 知乎 OAuth =====
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
ZHIHU_OAUTH_REDIRECT_URI=http://localhost:3100/api/auth/zhihu/callback
# 用于 HttpOnly Cookie 中 OAuth token 的加密签名（任意长随机串）
OAUTH_COOKIE_SECRET=

# 仅本人本机测试桌宠：将以下三项放入 .env.development.local（不进 Git）
# 用 npm run dev:pets 在回环地址运行；不用于公共产品服务。
PET_CHAT_TEST=0
PET_CHAT_MODEL=deepseek-v4.1-flash
QWEN_TOKEN_PLAN_INDIVIDUAL_API_KEY=
