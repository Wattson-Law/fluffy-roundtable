{
  "name": "fluffy-roundtable",
  "version": "1.0.0",
  "private": true,
  "description": "毛茸茸圆桌 Fluffy Roundtable — 在这儿刷知乎。刷完乱了，就问它们。",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "test:companion:api": "node scripts/verify_companion_api.mjs",
    "test:companion": "node --test scripts/companion.test.mjs scripts/intent.test.mjs scripts/trial.test.mjs scripts/pet-dialogue.test.mjs scripts/reading-pressure.test.mjs scripts/handoff-intent.test.mjs scripts/shared-memory.test.mjs scripts/listening-topics.test.mjs scripts/reader-thoughts.test.mjs scripts/session-reading.test.mjs",
    "pack:trial": "node scripts/pack_trial.mjs",
    "smoke": "node scripts/smoke.mjs",
    "dev:pets": "next dev --webpack --hostname 127.0.0.1 --port 3100",
    "stress:pets": "node scripts/stress_pet_route.mjs",
    "observe:pets": "node scripts/observe-pets.mjs"
  },
  "dependencies": {
    "framer-motion": "11.18.2",
    "lucide-react": "0.474.0",
    "next": "^16.4.6",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "22.13.1",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "esbuild": "0.25.12",
    "fflate": "0.8.2",
    "postcss": "8.5.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3"
  }
}
